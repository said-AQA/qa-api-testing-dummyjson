	"item": [
		{
			"name": "AUTH - Login success",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", () => {\r",
							"  pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"const json = pm.response.json();\r",
							"\r",
							"pm.test(\"accessToken is present\", () => {\r",
							"  pm.expect(json.accessToken).to.be.a(\"string\").and.not.empty;\r",
							"});\r",
							"\r",
							"pm.environment.set(\"token\", json.accessToken);\r",
							"pm.test(\"Content-Type is JSON\", () => {\r",
							"  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
							"});\r",
							"\r",
							"pm.test(\"Response time is under 1000ms\", () => {\r",
							"  pm.expect(pm.response.responseTime).to.be.below(1000);\r",
							"});\r",
							"\r",
							"const Ajv = require('ajv');\r",
							"const ajv = new Ajv({ allErrors: true });\r",
							"\r",
							"const schema = {\r",
							"  type: \"object\",\r",
							"  required: [\"id\", \"username\", \"email\", \"accessToken\", \"refreshToken\"],\r",
							"  properties: {\r",
							"    id: { type: \"number\" },\r",
							"    username: { type: \"string\" },\r",
							"    email: { type: \"string\" },\r",
							"    accessToken: { type: \"string\" },\r",
							"    refreshToken: { type: \"string\" }\r",
							"  }\r",
							"};\r",
							"\r",
							"pm.test(\"Login response matches schema\", () => {\r",
							"  const json = pm.response.json();\r",
							"  const valid = ajv.validate(schema, json);\r",
							"  pm.expect(valid, JSON.stringify(ajv.errors)).to.be.true;\r",
							"});\r",
							"\r",
							"pm.test(\"Performance: response time < 1500ms\", () => {\r",
							"  pm.expect(pm.response.responseTime).to.be.below(1500);\r",
							"});\r",
							"\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"username\": \"emilys\",\r\n  \"password\": \"emilyspass\",\r\n  \"expiresInMins\": 30\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://dummyjson.com/auth/login",
					"protocol": "https",
					"host": [
						"dummyjson",
						"com"
					],
					"path": [
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
